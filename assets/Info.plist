<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MicClean.app's Info.plist. build-mac.sh fills in @VERSION@ from Cargo.toml. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>MicClean</string>
	<key>CFBundleDisplayName</key>
	<string>MicClean</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.toocoolcello.micclean</string>
	<key>CFBundleExecutable</key>
	<string>micclean</string>
	<key>CFBundleIconFile</key>
	<string>micclean</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<!-- The echo source records system audio with a Core Audio process tap (macOS 14.2), and the
	     app links it directly, so older systems couldn't start it at all. -->
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>MicClean cleans up your mic before Discord and other apps hear it.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>For echo cancellation, MicClean listens to what your Mac plays, so it can take it back out of your mic.</string>
</dict>
</plist>
